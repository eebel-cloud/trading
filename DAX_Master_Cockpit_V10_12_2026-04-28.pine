//@version=5
// ==========================================
// DAX Master Cockpit V10.12 - AVWAP Zone
// Stand: 28.04.2026
// Änderungen gegenüber V10.11.5:
//   [Fix]  Pkt.5: Operator-Precedence-Bug in setup_text korrigiert.
//          "bias_long or bias_short and not adx_trade_ok" →
//          "(bias_long or bias_short) and not adx_trade_ok"
//   [Neu]  Pkt.4: ATR-adaptiver SAR (Abschnitt 1 + 2).
//          SAR Start-Step wechselt dynamisch zwischen eng (hohe Vola)
//          und normal (ruhige Phase) anhand konfigurierbarer ATR-Schwelle.
//          Alle SAR-Parameter sind per Input justierbar (Gruppe "SAR Parameter").
// ==========================================
indicator("DAX Master Cockpit V10.12 - AVWAP Zone", overlay=true, max_lines_count=10, max_labels_count=500)
// ==========================================
// 0. FARBEN
// ==========================================
C_WHITE   = color.rgb(255, 255, 255)
C_GREEN   = color.rgb(0, 255, 0)
C_RED     = color.rgb(255, 0, 0)
C_ORANGE  = color.rgb(255, 165, 0)
C_BLUE    = color.rgb(0, 112, 255)
C_GRAY    = color.rgb(128, 128, 128)
C_D_BLUE  = color.rgb(10, 20, 40)
C_D_GREEN = color.rgb(0, 100, 0)
C_D_RED   = color.rgb(150, 0, 0)
C_TEAL    = color.rgb(0, 128, 128)
C_GOLD    = color.rgb(255, 215, 0)
C_MAGENT  = color.rgb(255, 0, 255)
C_CYAN    = color.rgb(0, 255, 255)
// ==========================================
// 1. INPUTS
// ==========================================
grp_st = "Basis & Zeit"
trading_session = input.session("0900-1730", "Handels-Session (DE)", group=grp_st)
orb_time_input  = input.session("0900-0915", "ORB Zeitspanne (DE)", group=grp_st)
show_avwap = input.bool(true, "AVWAP + Zonen anzeigen", group=grp_st)
show_dol   = input.bool(true, "Daily Open (DOL) anzeigen", group="Location")
morning_lead_session = input.session("0915-1130", "Chef AVWAP: Vormittag", group=grp_st)
mix_session          = input.session("1130-1545", "Chef MIX: Übergang", group=grp_st)
afternoon_session    = input.session("1545-1730", "Chef EMA78: Nachmittag", group=grp_st)
early_risk_session   = input.session("0915-1000", "Risikomodus: 1. Handelsstunde", group=grp_st)
// --- AVWAP-Zonenlogik ---
grp_avwap_zone = "AVWAP Zonen"
avwap_inner_mult_in = input.float(
     1.0,
     "Innere AVWAP-Zone SD",
     minval = 0.5,
     maxval = 3.0,
     step = 0.25,
     group = grp_avwap_zone)
avwap_outer_mult_in = input.float(
     1.5,
     "Äußere AVWAP-Zone SD",
     minval = 0.5,
     maxval = 3.0,
     step = 0.25,
     group = grp_avwap_zone)
avwap_zone_transp = input.int(
     93,
     "Transparenz AVWAP-Zone",
     minval = 70,
     maxval = 95,
     group = grp_avwap_zone)
avwap_inner_line_transp = input.int(
     92,
     "Transparenz innere AVWAP-Grenze",
     minval = 50,
     maxval = 95,
     group = grp_avwap_zone)
avwap_outer_line_transp = input.int(
     88,
     "Transparenz äußere AVWAP-Grenze",
     minval = 40,
     maxval = 95,
     group = grp_avwap_zone)
atr_limit       = input.int(65, "ATR Hard Block (DAX)", group="Vola")
slope_threshold = input.float(0.3, "Slope Schwelle (in % der ATR)", step=0.05, group="Momentum")
adx_soft_gate = input.float(18.0, "ADX Soft Gate", step=0.5, group="ADX")
adx_full_gate = input.float(25.0, "ADX volle Trendfreigabe", step=0.5, group="ADX")
min_trade_score = input.float(4.0, "Mindestscore für Trade-Freigabe", step=0.5, group="Scoreboard")
a_score         = input.float(5.0, "A-Trade ab Score", step=0.5, group="Scoreboard")
aplus_score     = input.float(6.0, "A+ Trade ab Score", step=0.5, group="Scoreboard")
show_trade_marks = input.bool(false, "Trade-Pfeile / Exit-X im Chart anzeigen", group=grp_st)
show_sar_trade  = input.bool(true,  "SAR Trail letzter Move anzeigen", group=grp_st)
sar_mode        = input.string("Auto", "SAR Modus", options=["Auto", "Manual Long", "Manual Short", "Aus"], group=grp_st)
manual_sar_bars = input.int(80, "Manual SAR: letzte N Kerzen", minval=5, maxval=500, group=grp_st)
show_sar_raw    = input.bool(false, "SAR komplett anzeigen (Analyse)", group=grp_st)
// --- SAR Parameter (ATR-adaptiv) ---
// V10.12: Zwei feste SAR-Instanzen (tight/normal), Auswahl per ATR-Schwelle zur Laufzeit.
// SAR-Start eng (0.015): hohe Vola / Eroeffnung. SAR-Start normal (0.025): ruhige Phase.
// Increment 0.02 / Maximum 0.2 gelten fuer beide Instanzen gleichermassen.
grp_sar = "SAR Parameter"
atr_vola_high = input.float(35.0, "ATR-Schwelle hohe Vola (SAR)", minval=10.0, maxval=65.0, step=5.0, group=grp_sar, tooltip="Oberhalb dieser ATR wird der enge SAR (Start 0.015) aktiv. Darunter gilt der normale SAR (Start 0.025).")
// ==========================================
// 2. INDIKATOREN
// ==========================================
[_, _, adx_val] = ta.dmi(14, 14)
atr_val = ta.atr(14)
ema78 = ta.ema(close, 78)
ema8  = ta.ema(close, 8)
// V10.12: ATR-adaptiver SAR.
// Pine Script erlaubt keinen dynamischen start-Parameter in ta.sar().
// Loesung: Zwei SAR-Instanzen mit festem Start-Step werden parallel berechnet.
// sar_tight:  enger Start (0.015) fuer hohe Vola (Eroeffnungsphase, ATR > Schwelle).
// sar_normal: normaler Start (0.025) fuer ruhige Phasen (Mittag / Nachmittag).
// sar_val waehlt per ATR-Schwelle zur Laufzeit den passenden Wert.
sar_tight  = ta.sar(0.015, 0.02, 0.2)
sar_normal = ta.sar(0.025, 0.02, 0.2)
sar_val = atr_val > atr_vola_high ? sar_tight : sar_normal
// --- EMA8 Slope ---
ema8_slope = atr_val > 0 ? (ema8 - ema8[1]) / atr_val : 0
slope_col =
     ema8_slope > slope_threshold ? C_D_GREEN :
     ema8_slope < -slope_threshold ? C_D_RED :
     C_GRAY
// --- Force Index ---
fi_raw = volume * (close - close[1])
fi2  = ta.ema(fi_raw, 2)
fi13 = ta.ema(fi_raw, 13)
// --- MACD / Impuls ---
[macdLine, signalLine, _] = ta.macd(close, 12, 26, 9)
hist = macdLine - signalLine
impulse_state =
     hist > hist[1] and hist > 0 ? "STARK +" :
     hist < hist[1] and hist < 0 ? "STARK -" :
     "NEUTRAL"
impulse_col =
     impulse_state == "STARK +" ? C_BLUE :
     impulse_state == "STARK -" ? C_D_RED :
     C_GRAY
// --- Squeeze ---
basis = ta.sma(close, 20)
dev   = 2.0 * ta.stdev(close, 20)
is_sq = (basis + dev < basis + (ta.atr(20) * 1.5)) and (basis - dev > basis - (ta.atr(20) * 1.5))
sq_text =
     is_sq ? "COMPRESS" :
     not is_sq and is_sq[1] ? "FRESH REL" :
     "RELEASE"
sq_bg =
     is_sq ? C_D_RED :
     not is_sq and is_sq[1] ? C_GREEN :
     C_D_GREEN
// --- RVOL ---
vol_sma20 = ta.sma(volume, 20)
rvol = vol_sma20 > 0 ? volume / vol_sma20 : 0
rvol_col =
     rvol > 1.2 ? C_BLUE :
     rvol < 0.8 ? color.rgb(80, 80, 80) :
     C_GRAY
rvol_state =
     rvol > 1.2 ? "Aktiv" :
     rvol < 0.8 ? "Tote Zone" :
     "Normal"
// ==========================================
// 3. ZEITREGIME / CHEF
// ==========================================
is_xetra_session = not na(time(timeframe.period, trading_session + ":1234567", "Europe/Berlin"))
is_orb           = not na(time(timeframe.period, orb_time_input + ":1234567", "Europe/Berlin"))
is_xetra_start   = is_xetra_session and not is_xetra_session[1]
is_morning_lead = not na(time(timeframe.period, morning_lead_session + ":1234567", "Europe/Berlin"))
is_mix_lead     = not na(time(timeframe.period, mix_session + ":1234567", "Europe/Berlin"))
is_afternoon    = not na(time(timeframe.period, afternoon_session + ":1234567", "Europe/Berlin"))
is_early_risk   = not na(time(timeframe.period, early_risk_session + ":1234567", "Europe/Berlin"))
chef_text =
     is_morning_lead ? "AVWAP" :
     is_mix_lead ? "MIX" :
     is_afternoon ? "EMA78" :
     "OFF"
chef_detail =
     is_morning_lead ? "Morning Lead" :
     is_mix_lead ? "Transition" :
     is_afternoon ? "Afternoon Lead" :
     "Außerhalb"
chef_bg =
     is_morning_lead ? C_BLUE :
     is_mix_lead ? C_GRAY :
     is_afternoon ? C_TEAL :
     C_D_RED
// ==========================================
// 4. DAILY OPEN / AVWAP
// ==========================================
var float  dol_val = na
if nz(ta.change(time("D"))) != 0
    dol_val := open
var float  x_open = na
if is_xetra_start
    x_open := open
// --- Kumulativer AVWAP mit Varianz ---
var float  s_pv  = 0.0
var float  s_v   = 0.0
var float  s_pv2 = 0.0
if is_xetra_start
    s_pv  := close * nz(volume, 1)
    s_v   := nz(volume, 1)
    s_pv2 := close * close * nz(volume, 1)
else if is_xetra_session
    s_pv  += close * nz(volume, 1)
    s_v   += nz(volume, 1)
    s_pv2 += close * close * nz(volume, 1)
else
    s_pv  := 0.0
    s_v   := 0.0
    s_pv2 := 0.0
av_val = is_xetra_session and s_v > 0 ? s_pv / s_v : na
var_val = is_xetra_session and s_v > 0 ? math.max(0, (s_pv2 / s_v) - (av_val * av_val)) : 0.0
std_val = math.sqrt(var_val)
// --- AVWAP-Zonen: innere und äußere Standardabweichung ---
avwap_inner_mult = avwap_inner_mult_in
avwap_outer_mult = math.max(avwap_outer_mult_in, avwap_inner_mult_in)
av_upper_inner = av_val + std_val * avwap_inner_mult
av_lower_inner = av_val - std_val * avwap_inner_mult
av_upper_outer = av_val + std_val * avwap_outer_mult
av_lower_outer = av_val - std_val * avwap_outer_mult
// Kompatibilität / Hauptband entspricht äußerer Zone
av_upper = av_upper_outer
av_lower = av_lower_outer
avwap_long  = not na(av_val) and close > av_val
avwap_short = not na(av_val) and close < av_val
// --- AVWAP-Zonenstatus für Dashboard ---
avwap_zone_state =
     close > av_upper_outer ? "EXPAND +" :
     close < av_lower_outer ? "EXPAND -" :
     close > av_upper_inner ? "WATCH +" :
     close < av_lower_inner ? "WATCH -" :
     "VALUE"
avwap_zone_bg =
     avwap_zone_state == "EXPAND +" ? C_ORANGE :
     avwap_zone_state == "EXPAND -" ? C_ORANGE :
     avwap_zone_state == "WATCH +"  ? C_GRAY :
     avwap_zone_state == "WATCH -"  ? C_GRAY :
     C_D_GREEN
avwap_zone_detail =
     avwap_zone_state == "EXPAND +" ? "oberhalb +" + str.tostring(avwap_outer_mult, "#.##") + " SD" :
     avwap_zone_state == "EXPAND -" ? "unterhalb -" + str.tostring(avwap_outer_mult, "#.##") + " SD" :
     avwap_zone_state == "WATCH +"  ? "+" + str.tostring(avwap_inner_mult, "#.##") + " bis +" + str.tostring(avwap_outer_mult, "#.##") + " SD" :
     avwap_zone_state == "WATCH -"  ? "-" + str.tostring(avwap_inner_mult, "#.##") + " bis -" + str.tostring(avwap_outer_mult, "#.##") + " SD" :
     "innerhalb ±" + str.tostring(avwap_inner_mult, "#.##") + " SD"
// ==========================================
// 5. LEAD-BASIS / SIGNALBASIS
// ==========================================
v_t = is_xetra_session and not is_orb
hard_block =
     not is_xetra_session or
     is_orb or
     atr_val > atr_limit
// Vormittag: AVWAP ist Signalreferenz.
// Nachmittag: EMA78 ist Signalreferenz.
// MIX: AVWAP oder EMA78 darf führen, Score entscheidet.
morning_long_core  = is_morning_lead and not na(av_val) and close > av_val and ema8 > av_val
morning_short_core = is_morning_lead and not na(av_val) and close < av_val and ema8 < av_val
afternoon_long_core  = is_afternoon and close > ema78 and ema8 > ema78
afternoon_short_core = is_afternoon and close < ema78 and ema8 < ema78
mix_long_core =
     is_mix_lead and (
         (not na(av_val) and close > av_val and ema8 > av_val) or
         (close > ema78 and ema8 > ema78)
     )
mix_short_core =
     is_mix_lead and (
         (not na(av_val) and close < av_val and ema8 < av_val) or
         (close < ema78 and ema8 < ema78)
     )
lead_long_core  = morning_long_core or mix_long_core or afternoon_long_core
lead_short_core = morning_short_core or mix_short_core or afternoon_short_core
bias_long  = lead_long_core and v_t
bias_short = lead_short_core and v_t
bias_text = bias_long ? "LONG" : bias_short ? "SHORT" : "NEUTRAL"
bias_detail =
     bias_long and is_morning_lead ? "> AVWAP / EMA8 > AVWAP" :
     bias_short and is_morning_lead ? "< AVWAP / EMA8 < AVWAP" :
     bias_long and is_afternoon ? "> EMA78 / EMA8 > EMA78" :
     bias_short and is_afternoon ? "< EMA78 / EMA8 < EMA78" :
     bias_long and is_mix_lead ? "MIX: Long Lean" :
     bias_short and is_mix_lead ? "MIX: Short Lean" :
     "keine klare Richtung"
bias_bg = bias_long ? C_D_GREEN : bias_short ? C_D_RED : C_GRAY
// ==========================================
// 6. PULLBACK ALS BONUS, NICHT ALS PFLICHT
// ==========================================
var int  pb_count = 0
if ta.crossover(ema8, ema78) or ta.crossunder(ema8, ema78)
    pb_count := 0
pb_build_long  = bias_long and fi2 < 0 and v_t
pb_build_short = bias_short and fi2 > 0 and v_t
pb_ready_long =
     bias_long and
     impulse_state == "STARK +" and
     fi2 < 0 and
     v_t
pb_ready_short =
     bias_short and
     impulse_state == "STARK -" and
     fi2 > 0 and
     v_t
if (pb_ready_long and not pb_ready_long[1]) or (pb_ready_short and not pb_ready_short[1])
    pb_count += 1
pb_string = pb_count > 0 ? " #" + str.tostring(pb_count) : ""
pb_bonus_s =
     (pb_ready_long or pb_ready_short) and pb_count < 3 ? 1.0 :
     (pb_build_long or pb_build_short) and pb_count < 3 ? 0.5 :
     0.0
// ==========================================
// 7. SCOREBOARD MIT PB-BONUS
// ==========================================
trade_dir = bias_long ? 1 : bias_short ? -1 : 0
// ADX bleibt Score-Komponente
adx_s =
     adx_val >= adx_full_gate ? 1.0 :
     adx_val >= adx_soft_gate ? 0.5 :
     0.0
atr_s =
     atr_val > atr_limit ? 0.0 :
     atr_val <= atr_limit * 0.2 ? 0.5 :
     1.0
// RVOL bleibt unverändert: Score- und Farbinformation, kein Hardblock
rvol_s =
     rvol >= 1.2 ? 1.0 :
     rvol >= 0.8 ? 0.5 :
     0.0
fi_s =
     trade_dir == 1 and fi13 > 0 ? 1.0 :
     trade_dir == -1 and fi13 < 0 ? 1.0 :
     0.0
slope_s =
     trade_dir == 1 and ema8_slope > slope_threshold ? 1.0 :
     trade_dir == -1 and ema8_slope < -slope_threshold ? 1.0 :
     0.0
lead_s =
     trade_dir == 1 and is_morning_lead and morning_long_core ? 1.0 :
     trade_dir == -1 and is_morning_lead and morning_short_core ? 1.0 :
     trade_dir == 1 and is_mix_lead ? ((not na(av_val) and close > av_val ? 0.5 : 0.0) + (close > ema78 and ema8 > ema78 ? 0.5 : 0.0)) :
     trade_dir == -1 and is_mix_lead ? ((not na(av_val) and close < av_val ? 0.5 : 0.0) + (close < ema78 and ema8 < ema78 ? 0.5 : 0.0)) :
     trade_dir == 1 and is_afternoon and afternoon_long_core ? 1.0 :
     trade_dir == -1 and is_afternoon and afternoon_short_core ? 1.0 :
     0.0
t_s = adx_s + atr_s + rvol_s + fi_s + slope_s + lead_s + pb_bonus_s
score_title =
     t_s >= aplus_score ? "A+ TRADE" :
     t_s >= a_score ? "A TRADE" :
     t_s >= min_trade_score ? "A- WATCH" :
     t_s >= 3.0 ? "B- WATCH" :
     "WAIT"
score_bg =
     t_s >= aplus_score ? C_D_GREEN :
     t_s >= a_score ? C_TEAL :
     t_s >= min_trade_score ? color.rgb(150, 100, 0) :
     C_GRAY
score_ok = t_s >= min_trade_score
// ==========================================
// 8. ADX SOFT-GATE / SETUP / TRIGGER
// ==========================================
// ADX hat jetzt echte Signalauswirkung:
// ADX < 18: kein TREND READY, kein CONFIRM, kein ENTRY.
// ADX >= 18: Signal möglich.
// ADX >= 25: volle Trendqualität.
adx_trade_ok = adx_val >= adx_soft_gate
adx_full_ok  = adx_val >= adx_full_gate
trend_ready_long =
     bias_long and
     score_ok and
     adx_trade_ok and
     not hard_block
trend_ready_short =
     bias_short and
     score_ok and
     adx_trade_ok and
     not hard_block
setup_text =
     (pb_ready_long or pb_ready_short) and pb_count >= 3 ? "EXHAUST" :
     pb_ready_long or pb_ready_short ? "PB BONUS" :
     pb_build_long or pb_build_short ? "PB BUILD" :
     trend_ready_long or trend_ready_short ? "TREND READY" :
     (bias_long or bias_short) and not adx_trade_ok ? "WATCH" :
     "WAIT"
setup_detail =
     not adx_trade_ok and (bias_long or bias_short) ? "ADX schwach" :
     pb_ready_long ? "Long PB Bonus" + pb_string :
     pb_ready_short ? "Short PB Bonus" + pb_string :
     pb_build_long ? "FI(2) Reset Long" :
     pb_build_short ? "FI(2) Reset Short" :
     trend_ready_long ? "Lead Long erfüllt" :
     trend_ready_short ? "Lead Short erfüllt" :
     is_orb ? "ORB Zone" :
     "kein Setup"
setup_bg =
     setup_text == "PB BONUS" ? C_BLUE :
     setup_text == "PB BUILD" ? C_TEAL :
     setup_text == "TREND READY" ? C_D_GREEN :
     setup_text == "EXHAUST" ? C_ORANGE :
     setup_text == "WATCH" ? C_TEAL :
     C_GRAY
// Folgekerzenbestätigung:
// Das Grundsignal muss eine Kerze vorher bereit gewesen sein.
// Danach muss die neue Kerze in Signalfarbe aufbauen.
long_entry_confirm =
     trend_ready_long[1] and
     bias_long and
     close > open and
     score_ok and
     adx_trade_ok and
     not hard_block
short_entry_confirm =
     trend_ready_short[1] and
     bias_short and
     close < open and
     score_ok and
     adx_trade_ok and
     not hard_block
trigger_text =
     hard_block ? "BLOCKED" :
     long_entry_confirm ? "ENTRY L" :
     short_entry_confirm ? "ENTRY S" :
     trend_ready_long or trend_ready_short ? "CONFIRM" :
     (bias_long or bias_short) and not adx_trade_ok ? "WATCH" :
     bias_long or bias_short ? "WATCH" :
     "NO ENTRY"
trigger_detail =
     not is_xetra_session ? "außerhalb Session" :
     is_orb ? "ORB blockiert" :
     atr_val > atr_limit ? "ATR Hard Block" :
     long_entry_confirm ? "Kerze grün bestätigt" :
     short_entry_confirm ? "Kerze rot bestätigt" :
     trend_ready_long or trend_ready_short ? "Folgekerze abwarten" :
     (bias_long or bias_short) and not adx_trade_ok ? "ADX schwach" :
     bias_long or bias_short ? "Score/Trigger fehlt" :
     "kein Trigger"
trigger_bg =
     trigger_text == "ENTRY L" ? C_GREEN :
     trigger_text == "ENTRY S" ? C_RED :
     trigger_text == "CONFIRM" ? C_ORANGE :
     trigger_text == "WATCH" ? C_TEAL :
     trigger_text == "BLOCKED" ? C_D_RED :
     C_GRAY
action_text =
     hard_block ? "BLOCKED" :
     (bias_long or bias_short) and not adx_trade_ok ? "ADX WATCH" :
     is_early_risk and (long_entry_confirm or short_entry_confirm) ? "1/2 SIZE" :
     t_s >= aplus_score and (long_entry_confirm or short_entry_confirm) ? "A+ OK" :
     t_s >= a_score and (long_entry_confirm or short_entry_confirm) ? "TRADE OK" :
     trend_ready_long or trend_ready_short ? "CONFIRM" :
     t_s >= 3.0 ? "WATCH" :
     "WAIT"
action_bg =
     action_text == "BLOCKED" ? C_D_RED :
     action_text == "ADX WATCH" ? C_TEAL :
     action_text == "1/2 SIZE" ? C_ORANGE :
     action_text == "A+ OK" ? C_D_GREEN :
     action_text == "TRADE OK" ? C_TEAL :
     action_text == "CONFIRM" ? C_ORANGE :
     action_text == "WATCH" ? C_GRAY :
     C_GRAY
// ==========================================
// 9. TRADE-STATUS & EXIT VIA SAR
// ==========================================
var bool  l_a = false
var bool  s_a = false

// Neues Signal nur dann, wenn noch kein Trade in derselben Richtung aktiv ist.
new_long  = long_entry_confirm and not l_a
new_short = short_entry_confirm and not s_a
is_new = new_long or new_short

// Label-Arrays fuer Entry/Exit und SAR-Trail.
// Wichtig: Der SAR-Trail wird ueber Labels gefuehrt, damit alte Bewegungen aktiv geloescht werden koennen.
var label[] c_e = array.new_label()
var label[] sar_lbls = array.new_label()
var label[] exit_lbls = array.new_label()

// Neue Cockpit-Trades: alte Markierungen des vorherigen Moves loeschen.
if is_new
    while array.size(c_e) > 0
        label.delete(array.shift(c_e))
    while array.size(sar_lbls) > 0
        label.delete(array.shift(sar_lbls))
    while array.size(exit_lbls) > 0
        label.delete(array.shift(exit_lbls))

if new_long
    l_a := true
    s_a := false

if new_short
    s_a := true
    l_a := false

active_auto_trade = l_a or s_a

// Exit nur dann, wenn vorher tatsaechlich ein Cockpit-Trade aktiv war.
// Dadurch entsteht kein EXIT/keine SAR-Darstellung, wenn das Cockpit FLAT ist.
exit_now =
     active_auto_trade and (
         (l_a and close < sar_val) or
         (s_a and close > sar_val) or
         not is_xetra_session
     )
exit_from_long  = exit_now and l_a
exit_from_short = exit_now and s_a

manual_sar_long  = sar_mode == "Manual Long"
manual_sar_short = sar_mode == "Manual Short"
sar_auto_mode    = sar_mode == "Auto"
sar_off_mode     = sar_mode == "Aus"
manual_sar_active = show_sar_trade and (manual_sar_long or manual_sar_short)

trade_text =
     exit_now ? "EXIT" :
     l_a ? "HODL L" :
     s_a ? "HODL S" :
     manual_sar_long ? "MANUAL L" :
     manual_sar_short ? "MANUAL S" :
     "FLAT"

trade_bg =
     exit_now ? C_ORANGE :
     l_a ? C_D_GREEN :
     s_a ? C_D_RED :
     manual_sar_long ? C_D_GREEN :
     manual_sar_short ? C_D_RED :
     C_GRAY

trade_detail =
     exit_now ? "SAR Exit" :
     l_a or s_a ? "Auto Trail: SAR" :
     manual_sar_long ? "Manual SAR Long" :
     manual_sar_short ? "Manual SAR Short" :
     "kein Trade aktiv"

// ==========================================
// 10. CHART-SIGNALE / SAR — NUR LETZTER AKTIVER MOVE
// ==========================================
// Ziel:
// - Im Auto-Modus sind SAR-Punkte nur sichtbar, solange ein Cockpit-Trade aktiv ist.
// - Bei FLAT duerfen im Auto-Modus keine SAR-Punkte stehen bleiben.
// - Beim SAR-Exit wird der alte SAR-Trail geloescht und ein Exit-X gesetzt.
// - Bei neuem Trade werden alte Pfeile, SAR-Punkte und Exit-X geloescht.
// - Manual Long/Short ist bewusst manuell aktivierbar und zeigt nur ein begrenztes Fenster.

// Entry-Pfeile optional. Keine SAR-Punkte mehr in diesem Array, damit keine Doppel-/Altspuren entstehen.
if not show_trade_marks
    while array.size(c_e) > 0
        label.delete(array.shift(c_e))

if show_trade_marks and is_new
    array.push(c_e, label.new(
         bar_index,
         na,
         new_long ? "▲" : "▼",
         yloc = new_long ? yloc.belowbar : yloc.abovebar,
         color = color.new(C_WHITE, 100),
         textcolor = new_long ? C_GREEN : C_RED,
         style = label.style_none,
         size = size.normal))

manual_sar_window = bar_index >= last_bar_index - manual_sar_bars
sar_auto_long_now  = show_sar_trade and sar_auto_mode and l_a and not exit_now and not na(sar_val)
sar_auto_short_now = show_sar_trade and sar_auto_mode and s_a and not exit_now and not na(sar_val)
sar_manual_long_now  = show_sar_trade and manual_sar_long and manual_sar_window and not na(sar_val)
sar_manual_short_now = show_sar_trade and manual_sar_short and manual_sar_window and not na(sar_val)
sar_any_now = sar_auto_long_now or sar_auto_short_now or sar_manual_long_now or sar_manual_short_now
sar_is_long_now = sar_auto_long_now or sar_manual_long_now

// Wenn SAR ausgeschaltet wird, muessen alle SAR-/Exit-Markierungen weg.
// Im Auto-Modus bleiben die SAR-Punkte des letzten abgeschlossenen Moves erhalten,
// solange ein Exit-X existiert. Dadurch ist der letzte Move weiterhin lesbar.
if sar_off_mode
    while array.size(sar_lbls) > 0
        label.delete(array.shift(sar_lbls))
    while array.size(exit_lbls) > 0
        label.delete(array.shift(exit_lbls))
else if sar_auto_mode and not active_auto_trade and array.size(exit_lbls) == 0
    while array.size(sar_lbls) > 0
        label.delete(array.shift(sar_lbls))

// SAR-Exit: Trail des beendeten Moves bleibt stehen, zusätzlich wird ein Exit-X gesetzt.
// Der alte Move wird erst beim naechsten neuen Trade oder bei SAR Aus geloescht.
if exit_now
    while array.size(exit_lbls) > 0
        label.delete(array.shift(exit_lbls))
    array.push(exit_lbls, label.new(
         bar_index,
         na,
         "✖",
         xloc = xloc.bar_index,
         yloc = exit_from_short ? yloc.belowbar : yloc.abovebar,
         color = color.new(C_WHITE, 100),
         textcolor = C_GOLD,
         style = label.style_none,
         size = size.large))
else if sar_any_now
    array.push(sar_lbls, label.new(
         bar_index,
         sar_val,
         "•",
         xloc = xloc.bar_index,
         yloc = yloc.price,
         color = color.new(C_WHITE, 100),
         textcolor = sar_is_long_now ? C_GREEN : C_RED,
         style = label.style_none,
         size = size.small))

    // Schutz gegen Label-Limit: nur letzte 450 Punkte behalten.
    if array.size(sar_lbls) > 450
        label.delete(array.shift(sar_lbls))

sar_raw_plot = show_sar_raw and not na(sar_val) ? sar_val : na

// Trade-Status erst nach Markierung des Exit-X zuruecksetzen.
if exit_now
    l_a := false
    s_a := false
// ==========================================
// 11. HAUPT-DASHBOARD
// ==========================================
var table dash = table.new(position.top_right, 3, 13, bgcolor=color.rgb(15, 25, 50, 90), border_width=1, border_color=color.rgb(40,60,100))
if barstate.islast
    table.cell(dash, 0, 0, "DAX V10.12", text_color=C_WHITE, bgcolor=C_D_BLUE)
    table.cell(dash, 1, 0, "STATUS", text_color=C_WHITE, bgcolor=C_D_BLUE)
    table.cell(dash, 2, 0, "DETAILS", text_color=C_WHITE, bgcolor=C_D_BLUE)
    table.cell(dash, 0, 1, "CHEF", text_color=C_WHITE)
    table.cell(dash, 1, 1, chef_text, bgcolor=chef_bg, text_color=C_WHITE)
    table.cell(dash, 2, 1, chef_detail, text_color=C_WHITE)
    table.cell(dash, 0, 2, "BIAS", text_color=C_WHITE)
    table.cell(dash, 1, 2, bias_text, bgcolor=bias_bg, text_color=C_WHITE)
    table.cell(dash, 2, 2, bias_detail, text_color=C_WHITE)
    table.cell(dash, 0, 3, "TRIGGER", text_color=C_WHITE)
    table.cell(dash, 1, 3, trigger_text, bgcolor=trigger_bg, text_color=C_WHITE)
    table.cell(dash, 2, 3, trigger_detail, text_color=C_WHITE)
    table.cell(dash, 0, 4, "TRADE", text_color=C_WHITE)
    table.cell(dash, 1, 4, trade_text, bgcolor=trade_bg, text_color=C_WHITE)
    table.cell(dash, 2, 4, trade_detail, text_color=C_WHITE)
    table.cell(dash, 0, 5, "SQUEEZE", text_color=C_WHITE)
    table.cell(dash, 1, 5, sq_text, bgcolor=sq_bg, text_color=C_WHITE)
    table.cell(dash, 2, 5, "Bollinger/KC", text_color=C_WHITE)
    table.cell(dash, 0, 6, "IMPULS-MOM.", text_color=C_WHITE)
    table.cell(dash, 1, 6, impulse_state, bgcolor=impulse_col, text_color=C_WHITE)
    table.cell(dash, 2, 6, "Elder Impulse", text_color=C_WHITE)
    table.cell(dash, 0, 7, "ENERGIE (ADX)", text_color=C_WHITE)
    table.cell(dash, 1, 7, str.tostring(math.round(adx_val, 1)), bgcolor=adx_val >= adx_full_gate ? C_D_GREEN : adx_val >= adx_soft_gate ? C_TEAL : C_GRAY, text_color=C_WHITE)
    table.cell(dash, 2, 7, adx_val >= adx_full_gate ? "Trend stark" : adx_val >= adx_soft_gate ? "Trend ok" : "ADX schwach", text_color=C_WHITE)
    table.cell(dash, 0, 8, "VOLA (ATR)", text_color=C_WHITE)
    table.cell(dash, 1, 8, str.tostring(math.round(atr_val, 1)), bgcolor=atr_val > atr_limit ? C_RED : C_D_GREEN, text_color=C_WHITE)
    table.cell(dash, 2, 8, "Limit: " + str.tostring(atr_limit), text_color=C_WHITE)
    table.cell(dash, 0, 9, "RVOL (20)", text_color=C_WHITE)
    table.cell(dash, 1, 9, str.tostring(rvol, "#.##"), bgcolor=rvol_col, text_color=C_WHITE)
    table.cell(dash, 2, 9, rvol_state, text_color=C_WHITE)
    table.cell(dash, 0, 10, "AVWAP Zone", text_color=C_WHITE)
    table.cell(dash, 1, 10, avwap_zone_state, bgcolor=avwap_zone_bg, text_color=C_WHITE)
    table.cell(dash, 2, 10, avwap_zone_detail, text_color=C_WHITE)
    table.cell(dash, 0, 11, "EMA 8 Slope", text_color=C_WHITE)
    table.cell(dash, 1, 11, str.tostring(ema8_slope, "#.##"), bgcolor=slope_col, text_color=C_WHITE)
    table.cell(dash, 2, 11, ema8_slope > slope_threshold ? "Beschleunigung" : ema8_slope < -slope_threshold ? "Abverkauf" : "Neutral", text_color=C_WHITE)
// ==========================================
// 12. SCOREBOARD
// ==========================================
var table s_dash = table.new(position.bottom_right, 3, 10, bgcolor=color.rgb(15, 25, 50, 90), border_width=1, border_color=color.rgb(40,60,100))
if barstate.islast
    is_a = bias_long or bias_short or l_a or s_a
    tc = is_a ? C_WHITE : color.new(C_WHITE, 60)
    score_display = is_a ? str.tostring(t_s, "#.#") + " / 7" : "---"
    table.cell(s_dash, 0, 0, score_title, text_color=tc, bgcolor=score_bg)
    table.cell(s_dash, 1, 0, score_display, text_color=tc, bgcolor=score_bg)
    table.cell(s_dash, 2, 0, action_text, text_color=C_WHITE, bgcolor=action_bg)
    table.cell(s_dash, 0, 1, "ADX", text_color=tc)
    table.cell(s_dash, 1, 1, is_a ? str.tostring(adx_s, "#.#") : "-", bgcolor=is_a ? (adx_s == 1.0 ? C_D_GREEN : adx_s == 0.5 ? C_TEAL : C_GRAY) : color.rgb(15,25,50,90), text_color=C_WHITE)
    table.cell(s_dash, 2, 1, adx_val >= adx_full_gate ? "Trend" : adx_val >= adx_soft_gate ? "ok" : "schwach", text_color=tc)
    table.cell(s_dash, 0, 2, "ATR", text_color=tc)
    table.cell(s_dash, 1, 2, is_a ? str.tostring(atr_s, "#.#") : "-", bgcolor=is_a ? (atr_s == 1.0 ? C_D_GREEN : atr_s == 0.5 ? C_TEAL : C_D_RED) : color.rgb(15,25,50,90), text_color=C_WHITE)
    table.cell(s_dash, 2, 2, atr_val > atr_limit ? "BLOCK" : "handelbar", text_color=tc)
    table.cell(s_dash, 0, 3, "RVOL", text_color=tc)
    table.cell(s_dash, 1, 3, is_a ? str.tostring(rvol_s, "#.#") : "-", bgcolor=is_a ? (rvol_s == 1.0 ? C_D_GREEN : rvol_s == 0.5 ? C_TEAL : C_GRAY) : color.rgb(15,25,50,90), text_color=C_WHITE)
    table.cell(s_dash, 2, 3, rvol_state, text_color=tc)
    table.cell(s_dash, 0, 4, "FI(13)", text_color=tc)
    table.cell(s_dash, 1, 4, is_a ? str.tostring(fi_s, "#.#") : "-", bgcolor=is_a ? (fi_s == 1.0 ? C_D_GREEN : C_GRAY) : color.rgb(15,25,50,90), text_color=C_WHITE)
    table.cell(s_dash, 2, 4, fi_s == 1.0 ? "Flow passt" : "Flow fehlt", text_color=tc)
    table.cell(s_dash, 0, 5, "Slope", text_color=tc)
    table.cell(s_dash, 1, 5, is_a ? str.tostring(slope_s, "#.#") : "-", bgcolor=is_a ? (slope_s == 1.0 ? C_D_GREEN : C_GRAY) : color.rgb(15,25,50,90), text_color=C_WHITE)
    table.cell(s_dash, 2, 5, slope_s == 1.0 ? "Druck" : "flach", text_color=tc)
    table.cell(s_dash, 0, 6, "LEAD", text_color=tc)
    table.cell(s_dash, 1, 6, is_a ? str.tostring(lead_s, "#.#") : "-", bgcolor=is_a ? (lead_s == 1.0 ? C_D_GREEN : lead_s == 0.5 ? C_TEAL : C_GRAY) : color.rgb(15,25,50,90), text_color=C_WHITE)
    table.cell(s_dash, 2, 6, chef_text, text_color=tc)
    table.cell(s_dash, 0, 7, "PB Bonus", text_color=tc)
    table.cell(s_dash, 1, 7, is_a ? str.tostring(pb_bonus_s, "#.#") : "-", bgcolor=is_a ? (pb_bonus_s == 1.0 ? C_D_GREEN : pb_bonus_s == 0.5 ? C_TEAL : C_GRAY) : color.rgb(15,25,50,90), text_color=C_WHITE)
    table.cell(s_dash, 2, 7, pb_count >= 3 ? "Exhaustion" : pb_bonus_s > 0 ? "Bonus" : "kein PB", text_color=tc)
    table.cell(s_dash, 0, 8, "PB Count", text_color=tc)
    table.cell(s_dash, 1, 8, pb_count > 0 ? str.tostring(pb_count) : "-", bgcolor=pb_count >= 3 ? C_ORANGE : C_GRAY, text_color=C_WHITE)
    table.cell(s_dash, 2, 8, pb_count >= 3 ? "Vorsicht" : "ok", text_color=tc)
    table.cell(s_dash, 0, 9, "MODE", text_color=tc)
    table.cell(s_dash, 1, 9, is_early_risk ? "RISK" : "NORMAL", bgcolor=is_early_risk ? C_ORANGE : C_D_BLUE, text_color=C_WHITE)
    table.cell(s_dash, 2, 9, is_early_risk ? "1/2 Size" : "Standard", text_color=tc)
// ==========================================
// 13. PLOTS
// ==========================================
plot(show_dol and not na(dol_val) ? dol_val : na, "DOL", color=color.new(C_GRAY, 55), style=plot.style_linebr, linewidth=1, display=display.all)
// --- AVWAP + Zonen 1.0 bis 1.5 SD ---
plot_avwap = plot(
     show_avwap and not na(av_val) ? av_val : na,
     "AVWAP",
     color = C_WHITE,
     linewidth = 2,
     style = plot.style_linebr,
     display = display.all)
// Innere Grenzen, standardmäßig ±1.0 SD
plot_upper_inner = plot(
     show_avwap and not na(av_upper_inner) ? av_upper_inner : na,
     "AVWAP Upper Inner SD",
     color = color.new(C_WHITE, avwap_inner_line_transp),
     linewidth = 1,
     style = plot.style_linebr,
     display = display.all)
plot_lower_inner = plot(
     show_avwap and not na(av_lower_inner) ? av_lower_inner : na,
     "AVWAP Lower Inner SD",
     color = color.new(C_WHITE, avwap_inner_line_transp),
     linewidth = 1,
     style = plot.style_linebr,
     display = display.all)
// Äußere Grenzen, standardmäßig ±1.5 SD
plot_upper_outer = plot(
     show_avwap and not na(av_upper_outer) ? av_upper_outer : na,
     "AVWAP Upper Outer SD",
     color = color.new(C_WHITE, avwap_outer_line_transp),
     linewidth = 1,
     style = plot.style_linebr,
     display = display.all)
plot_lower_outer = plot(
     show_avwap and not na(av_lower_outer) ? av_lower_outer : na,
     "AVWAP Lower Outer SD",
     color = color.new(C_WHITE, avwap_outer_line_transp),
     linewidth = 1,
     style = plot.style_linebr,
     display = display.all)
// Dezente graue Beobachtungszonen zwischen 1.0 und 1.5 SD
fill(
     plot_upper_inner,
     plot_upper_outer,
     color = show_avwap ? color.new(C_GRAY, avwap_zone_transp) : na,
     title = "AVWAP obere Beobachtungszone")
fill(
     plot_lower_inner,
     plot_lower_outer,
     color = show_avwap ? color.new(C_GRAY, avwap_zone_transp) : na,
     title = "AVWAP untere Beobachtungszone")
// SAR-Logik:
// Der letzte aktive SAR-Move wird über Labels gezeichnet, damit alte Moves bei neuem Trade gelöscht werden.
// Optional kann der vollständige SAR für Analysezwecke als Plot eingeblendet werden.
plot(sar_raw_plot,    "SAR komplett Analyse", color=color.new(C_GRAY, 35), style=plot.style_circles, linewidth=1, display=display.all)
plot(ema78, "EMA 78", color=C_ORANGE, linewidth=2, display=display.all)
plot(ema8, "EMA 8", color=C_CYAN, linewidth=1, display=display.all)
bgcolor(is_orb ? color.new(C_GRAY, 80) : not is_xetra_session ? color.new(C_RED, 95) : na)
