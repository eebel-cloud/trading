//@version=5indicator("NASDAQ Master Cockpit V10.4 - DAX Radar", overlay=true, max_lines_count=10, max_labels_count=500)// ==========================================// 0. FARBEN// ==========================================C_WHITE = color.rgb(255, 255, 255)C_GREEN = color.rgb(0, 255, 0)C_RED = color.rgb(255, 0, 0)C_ORANGE = color.rgb(255, 165, 0)C_BLUE = color.rgb(0, 112, 255)C_GRAY = color.rgb(128, 128, 128)C_D_BLUE = color.rgb(10, 20, 40)C_D_GREEN = color.rgb(0, 100, 0)C_D_RED = color.rgb(150, 0, 0)C_TEAL = color.rgb(0, 128, 128)C_MAGENT = color.rgb(255, 0, 255)C_GOLD = color.rgb(255, 215, 0)C_CYAN = color.rgb(0, 255, 255)C_L_GOLD = color.rgb(255, 223, 0) // Helles Gold für den Alert// ==========================================// 1. INPUTS// ==========================================grp_st = "Basis & Zeit"trading_session = input.session("1530-2200", "Handels-Fokus (US)", group=grp_st)orb_time_input = input.session("1530-1545", "Opening Range (ORB)", group=grp_st)show_avwap = input.bool(true, "AVWAP (15:30) im Chart anzeigen", group=grp_st)show_dol = input.bool(true, "Daily Open (DOL) anzeigen", group="Location")atr_limit = input.int(160, "ATR Hard Block (NAS)", group="Vola")slope_threshold = input.float(0.25, "Slope Schwelle (in % der ATR)", step=0.05, group="Momentum")dax_ticker = input.symbol("CAPITALCOM:DE40", "DAX Symbol (für Radar)", group="Cross-Asset")// ==========================================// 2. BERECHNUNGEN & INDIKATOREN (NASDAQ)// ==========================================[_, _, adx_val] = ta.dmi(14, 14)atr_val = ta.atr(14)ema78 = ta.ema(close, 78)ema8 = ta.ema(close, 8)ema13 = ta.ema(close, 13)sar_val = ta.sar(0.02, 0.02, 0.2)// --- EMA 8 SLOPE (ATR Normalisiert) ---ema8_slope = atr_val > 0 ? (ema8 - ema8[1]) / atr_val : 0slope_col = ema8_slope > slope_threshold ? C_D_GREEN : ema8_slope < -slope_threshold ? C_D_RED : C_GRAY// --- Force Index ---fi_raw = volume * (close - close[1])fi2 = ta.ema(fi_raw, 2)fi13 = ta.ema(fi_raw, 13)// --- Impulse ---[macd_val, signal_val, _] = ta.macd(close, 12, 26, 9)imp_up = (macd_val - signal_val > macd_val[1] - signal_val[1]) and (ema13 > ema13[1])imp_dn = (macd_val - signal_val < macd_val[1] - signal_val[1]) and (ema13 < ema13[1])impulse_state = imp_up ? "STARK +" : imp_dn ? "STARK -" : "NEUTRAL"impulse_col = imp_up ? C_BLUE : imp_dn ? C_D_RED : C_GRAY// --- Squeeze ---sma20 = ta.sma(close, 20)dev20 = 2.0 * ta.stdev(close, 20)atr20_mult = ta.atr(20) * 1.5is_sq = (sma20 + dev20 < sma20 + atr20_mult) and (sma20 - dev20 > sma20 - atr20_mult)sq_text = is_sq ? "COMPRESS" : (not is_sq and is_sq[1]) ? "FRESH REL" : "RELEASE"sq_bg = is_sq ? C_D_RED : (not is_sq and is_sq[1]) ? C_GREEN : C_D_GREEN// --- RVOL ---vol_sma20 = ta.sma(volume, 20)rvol = vol_sma20 > 0 ? volume / vol_sma20 : 0rvol_col = rvol > 1.2 ? C_BLUE : (rvol < 0.8 ? color.rgb(80, 80, 80) : C_GRAY)rvol_state = rvol > 1.2 ? "Aktiv" : (rvol < 0.8 ? "Tote Zone" : "Normal")// ==========================================// 3. CROSS-ASSET LOGIK (DAX SCORE BERECHNUNG)// ==========================================calc_dax_score() =>    e78 = ta.ema(close, 78)    e8 = ta.ema(close, 8)    dir = e8 > e78 ? 1 : -1    [_, _, adx_v] = ta.dmi(14, 14)    atr_v = ta.atr(14)    f_raw = volume * (close - close[1])    f13_v = ta.ema(f_raw, 13)    v_sma20 = ta.sma(volume, 20)    rvol_v = v_sma20 > 0 ? volume / v_sma20 : 0    slope_v = atr_v > 0 ? (e8 - e8[1]) / atr_v : 0        adx_s = adx_v >= 25.0 ? 1.0 : (adx_v >= 18.0 ? 0.5 : 0.0)    rvol_s = rvol_v >= 1.2 ? 1.0 : (rvol_v >= 0.8 ? 0.5 : 0.0)    atr_s = (atr_v > 65) ? 0.0 : (atr_v <= (65 * 0.2) ? 0.5 : 1.0)    fi_s = (dir == 1 and f13_v > 0) or (dir == -1 and f13_v < 0) ? 1.0 : 0.0    slope_s = (dir == 1 and slope_v > 0.3) or (dir == -1 and slope_v < -0.3) ? 1.0 : 0.0        adx_s + rvol_s + atr_s + fi_s + slope_sdax_score = request.security(dax_ticker, timeframe.period, calc_dax_score())// ==========================================// 4. ANCHORS & PERF (NASDAQ)// ==========================================var float dol_val = naif nz(ta.change(time("D"))) != 0    dol_val := openis_us_sess = not na(time(timeframe.period, "1530-2200:1234567", "Europe/Berlin"))is_orb = not na(time(timeframe.period, orb_time_input + ":1234567", "Europe/Berlin"))is_us_start = is_us_sess and not is_us_sess[1]var float us_open = navar float p_pre_f = naif is_us_start    us_open := open    if not na(dol_val)        p_pre_f := ((open - dol_val) / dol_val) * 100curr_p_pre = not na(p_pre_f) ? p_pre_f : (not na(dol_val) ? ((close - dol_val) / dol_val) * 100 : na)curr_p_cash = not na(us_open) ? ((close - us_open) / us_open) * 100 : na// --- AVWAP ---var float s_pv = 0.0var float s_v = 0.0if is_us_start    s_pv := close * nz(volume, 1)    s_v := nz(volume, 1)else if is_us_sess    s_pv += (close * nz(volume, 1))    s_v += nz(volume, 1)else    s_pv := 0.0    s_v := 0.0av_val = (is_us_sess and s_v > 0) ? s_pv / s_v : na// ==========================================// 5. SIGNAL & PULLBACK LOGIK// ==========================================v_t = is_us_sess and not is_orbvar bool l_a = falsevar bool s_a = falsevar int pb_count = 0if ta.crossover(ema8, ema78) or ta.crossunder(ema8, ema78)    pb_count := 0l_t = (ema8 > ema78) and (close > sar_val) and (close > ema78) and v_ts_t = (ema8 < ema78) and (close < sar_val) and (close < ema78) and v_tis_new = (l_t and not l_a) or (s_t and not s_a)buy_dip = (ema8 > ema78) and (close > ema78) and (impulse_state == "STARK +") and (fi2 < 0) and v_tsell_rally = (ema8 < ema78) and (close < ema78) and (impulse_state == "STARK -") and (fi2 > 0) and v_tif (buy_dip and not buy_dip[1]) or (sell_rally and not sell_rally[1])    pb_count += 1if l_t    l_a := true    s_a := falseif s_t    s_a := true    l_a := falseexit_now = (l_a and close < sar_val) or (s_a and close > sar_val) or not is_us_sess// ==========================================// 6. VISUELLE ELEMENTE (Pure Clean)// ==========================================var label[] c_e = array.new_label()if is_new    while array.size(c_e) > 0        label.delete(array.shift(c_e))if (l_a or s_a) and not na(sar_val)    if is_new        array.push(c_e, label.new(bar_index, na, l_t ? "▲" : "▼", yloc=l_t ? yloc.belowbar : yloc.abovebar, color=color.new(C_WHITE, 100), textcolor=(l_t ? C_GREEN : C_RED), style=label.style_none, size=size.normal))        if not exit_now        array.push(c_e, label.new(bar_index, sar_val, "•", xloc=xloc.bar_index, yloc=yloc.price, color=color.new(C_WHITE, 100), textcolor=(l_a ? C_GREEN : C_RED), style=label.style_none, size=size.small))            if exit_now        array.push(c_e, label.new(bar_index, sar_val, "✖", xloc=xloc.bar_index, yloc=yloc.price, color=color.new(C_WHITE, 100), textcolor=C_ORANGE, style=label.style_none, size=size.normal))if exit_now    l_a := false    s_a := false// ==========================================// 7. DASHBOARD (12 Zeilen)// ==========================================pb_string = pb_count > 0 ? " (#" + str.tostring(pb_count) + ")" : ""sig_text = l_t ? "▲ ENTRY L" : s_t ? "▼ ENTRY S" : buy_dip ? "↺ BUY DIP" + pb_string : sell_rally ? "↻ SELL RLY" + pb_string : "WAIT"sig_bg = l_t ? C_GREEN : s_t ? C_RED : buy_dip ? (pb_count >= 3 ? C_ORANGE : C_BLUE) : sell_rally ? (pb_count >= 3 ? C_RED : C_ORANGE) : C_GRAYpb_detail = pb_count >= 3 ? "EXHAUSTION RISK" : "FI(2) Reload"detail_text = is_orb ? "ORB ZONE" : (buy_dip or sell_rally) ? pb_detail : "TRADE OK"var table dash = table.new(position.top_right, 3, 12, bgcolor=color.rgb(15, 25, 50, 90), border_width=1, border_color=color.rgb(40,60,100))if barstate.islast    table.cell(dash, 0, 0, "NASDAQ V10.4", text_color=C_WHITE, bgcolor=C_D_BLUE)    table.cell(dash, 1, 0, "STATUS", text_color=C_WHITE, bgcolor=C_D_BLUE)    table.cell(dash, 2, 0, "DETAILS", text_color=C_WHITE, bgcolor=C_D_BLUE)        table.cell(dash, 0, 1, "B: SIGNAL", text_color=C_WHITE)    table.cell(dash, 1, 1, sig_text, bgcolor=sig_bg, text_color=C_WHITE)    table.cell(dash, 2, 1, detail_text, text_color=C_WHITE)        table.cell(dash, 0, 2, "LFD. TRADE", text_color=C_WHITE)    table.cell(dash, 1, 2, l_a ? "HODL L" : s_a ? "HODL S" : "---", bgcolor=(l_a ? C_D_GREEN : s_a ? C_D_RED : C_GRAY), text_color=C_WHITE)    table.cell(dash, 2, 2, "Trail: SAR", text_color=C_WHITE)        table.cell(dash, 0, 3, "SQUEEZE", text_color=C_WHITE)    table.cell(dash, 1, 3, sq_text, bgcolor=sq_bg, text_color=C_WHITE)    table.cell(dash, 2, 3, "Bollinger/KC", text_color=C_WHITE)        table.cell(dash, 0, 4, "IMPULS-MOM.", text_color=C_WHITE)    table.cell(dash, 1, 4, impulse_state, bgcolor=impulse_col, text_color=C_WHITE)    table.cell(dash, 2, 4, "Elder Impulse", text_color=C_WHITE)        table.cell(dash, 0, 5, "ENERGIE (ADX)", text_color=C_WHITE)    table.cell(dash, 1, 5, str.tostring(math.round(adx_val, 1)), bgcolor=(adx_val >= 18.0 ? C_TEAL : C_GRAY), text_color=C_WHITE)    table.cell(dash, 2, 5, (close > us_open ? "Über Open" : "Unter Open"), text_color=C_WHITE)        table.cell(dash, 0, 6, "VOLA (ATR)", text_color=C_WHITE)    table.cell(dash, 1, 6, str.tostring(math.round(atr_val, 1)), bgcolor=(atr_val > atr_limit ? C_RED : C_D_GREEN), text_color=C_WHITE)    table.cell(dash, 2, 6, "Limit: " + str.tostring(atr_limit), text_color=C_WHITE)        table.cell(dash, 0, 7, "RVOL (20)", text_color=C_WHITE)    table.cell(dash, 1, 7, str.tostring(rvol, "#.##"), bgcolor=rvol_col, text_color=C_WHITE)    table.cell(dash, 2, 7, rvol_state, text_color=C_WHITE)        table.cell(dash, 0, 8, "Perf. Pre", text_color=C_WHITE)    table.cell(dash, 1, 8, str.tostring(curr_p_pre, "#.##") + "%", bgcolor=(na(curr_p_pre) ? C_GRAY : curr_p_pre > 0.3 ? C_D_GREEN : curr_p_pre < -0.3 ? C_D_RED : C_GRAY), text_color=C_WHITE)    table.cell(dash, 2, 8, "00:00 - 15:29", text_color=C_WHITE)        table.cell(dash, 0, 9, "Perf. Cash", text_color=C_WHITE)    table.cell(dash, 1, 9, na(curr_p_cash) ? "---" : str.tostring(curr_p_cash, "#.##") + "%", bgcolor=(na(curr_p_cash) ? C_GRAY : curr_p_cash > 0.3 ? C_D_GREEN : curr_p_cash < -0.3 ? C_D_RED : C_GRAY), text_color=C_WHITE)    table.cell(dash, 2, 9, "ab 15:30", text_color=C_WHITE)    table.cell(dash, 0, 10, "EMA 8 Slope", text_color=C_WHITE)    table.cell(dash, 1, 10, str.tostring(ema8_slope, "#.##"), bgcolor=slope_col, text_color=C_WHITE)    table.cell(dash, 2, 10, (ema8_slope > slope_threshold ? "Beschleunigung" : ema8_slope < -slope_threshold ? "Abverkauf" : "Neutral"), text_color=C_WHITE)    // NEU: DAX RADAR ZEILE    table.cell(dash, 0, 11, "DAX Radar", text_color=C_WHITE)    table.cell(dash, 1, 11, dax_score >= 3.0 ? "A-TRADE (" + str.tostring(dax_score, "#.#") + ")" : "Score: " + str.tostring(dax_score, "#.#"), bgcolor=(dax_score >= 3.0 ? C_L_GOLD : C_GRAY), text_color=(dax_score >= 3.0 ? color.black : C_WHITE))    table.cell(dash, 2, 11, dax_score >= 3.0 ? "!!! CHECK DAX !!!" : "Warten...", text_color=C_WHITE)// ==========================================// 8. SCOREBOARD GHOST (NASDAQ - Max 5.0 Pkt)// ==========================================trade_dir = (l_t or l_a) ? 1 : (s_t or s_a) ? -1 : 0adx_s = adx_val >= 25.0 ? 1.0 : (adx_val >= 18.0 ? 0.5 : 0.0)rvol_s = rvol >= 1.2 ? 1.0 : (rvol >= 0.8 ? 0.5 : 0.0)atr_s = (atr_val > atr_limit) ? 0.0 : (atr_val <= (atr_limit * 0.2) ? 0.5 : 1.0)fi_s = (trade_dir == 1 and fi13 > 0) or (trade_dir == -1 and fi13 < 0) ? 1.0 : 0.0slope_s = (trade_dir == 1 and ema8_slope > slope_threshold) or (trade_dir == -1 and ema8_slope < -slope_threshold) ? 1.0 : 0.0t_s = adx_s + rvol_s + atr_s + fi_s + slope_svar table s_dash = table.new(position.bottom_right, 2, 6, bgcolor=color.rgb(15, 25, 50, 90), border_width=1, border_color=color.rgb(40,60,100))if barstate.islast    is_a = l_a or s_a or l_t or s_t    tc = is_a ? C_WHITE : color.new(C_WHITE, 60)    ac = is_a ? (t_s >= 4.5 ? C_D_GREEN : t_s >= 3.0 ? C_TEAL : color.rgb(150, 100, 0)) : color.rgb(15, 25, 50, 90)    score_title = is_a ? (t_s >= 4.5 ? "A+ TRADE" : t_s >= 3.0 ? "A- TRADE" : "B- TRADE") : "WAITING"        table.cell(s_dash, 0, 0, score_title, text_color=tc, bgcolor=ac)    table.cell(s_dash, 1, 0, is_a ? str.tostring(t_s, "#.#") + " Pkt" : "---", text_color=tc, bgcolor=ac)    table.cell(s_dash, 0, 1, "ADX (" + str.tostring(math.round(adx_val, 1)) + ")", text_color=tc)    table.cell(s_dash, 1, 1, is_a ? str.tostring(adx_s, "#.#") : "-", bgcolor=is_a ? (adx_s == 1.0 ? C_D_GREEN : C_TEAL) : color.rgb(15,25,50,90))    table.cell(s_dash, 0, 2, "ATR (" + str.tostring(math.round(atr_val, 1)) + ")", text_color=tc)    table.cell(s_dash, 1, 2, is_a ? str.tostring(atr_s, "#.#") : "-", bgcolor=is_a ? (atr_s == 1.0 ? C_D_GREEN : C_TEAL) : color.rgb(15,25,50,90))    table.cell(s_dash, 0, 3, "RVOL (" + str.tostring(rvol, "#.##") + ")", text_color=tc)    table.cell(s_dash, 1, 3, is_a ? str.tostring(rvol_s, "#.#") : "-", bgcolor=is_a ? (rvol_s == 1.0 ? C_D_GREEN : C_TEAL) : color.rgb(15,25,50,90))    table.cell(s_dash, 0, 4, "FI (13)", text_color=tc)    table.cell(s_dash, 1, 4, is_a ? str.tostring(fi_s, "#.#") : "-", bgcolor=is_a ? (fi_s == 1.0 ? C_D_GREEN : C_TEAL) : color.rgb(15,25,50,90))    table.cell(s_dash, 0, 5, "Slope", text_color=tc)    table.cell(s_dash, 1, 5, is_a ? str.tostring(slope_s, "#.#") : "-", bgcolor=is_a ? (slope_s == 1.0 ? C_D_GREEN : C_TEAL) : color.rgb(15,25,50,90))// ==========================================// 9. PLOTS// ==========================================plot(show_dol and not na(dol_val) ? dol_val : na, "DOL", color=C_MAGENT, style=plot.style_linebr, linewidth=2, display=display.all)plot(show_avwap and not na(av_val) ? av_val : na, "AVWAP", color=C_WHITE, linewidth=2, style=plot.style_linebr, display=display.all)plot(ema78, "EMA 78", color=C_ORANGE, linewidth=2, display=display.all)plot(ema8, "EMA 8", color=C_CYAN, linewidth=1, display=display.all)bgcolor(is_orb ? color.new(C_GRAY, 80) : not is_us_sess ? color.new(C_RED, 95) : na)