//@version=5indicator("DAX Mean-Reversion Map V1.2 - AVWAP Zonen + EMA8", overlay=true, max_lines_count=10, max_labels_count=50)// ==========================================// 0. FARBEN// ==========================================C_WHITE   = color.rgb(255, 255, 255)C_GREEN   = color.rgb(0, 255, 0)C_RED     = color.rgb(255, 0, 0)C_ORANGE  = color.rgb(255, 165, 0)C_BLUE    = color.rgb(0, 112, 255)C_GRAY    = color.rgb(128, 128, 128)C_D_BLUE  = color.rgb(10, 20, 40)C_D_GREEN = color.rgb(0, 100, 0)C_D_RED   = color.rgb(150, 0, 0)C_TEAL    = color.rgb(0, 128, 128)C_CYAN    = color.rgb(0, 255, 255)// ==========================================// 1. INPUTS// ==========================================grp_main = "Basis"trading_session = input.session("0900-1730", "XETRA Session", group=grp_main)show_avwap = input.bool(true, "AVWAP anzeigen", group=grp_main)show_bands = input.bool(true, "Zonen/Bänder anzeigen", group=grp_main)show_ema8  = input.bool(true, "EMA 8 anzeigen", group=grp_main)// Innere und äußere Zoneinner_band_mult_in = input.float(1.0, "Innere SD-Grenze", minval=0.5, maxval=3.0, step=0.25, group=grp_main)outer_band_mult_in = input.float(1.5, "Äußere SD-Grenze", minval=0.5, maxval=3.0, step=0.25, group=grp_main)grp_dash = "Dashboard"show_dashboard = input.bool(true, "Dashboard anzeigen", group=grp_dash)slope_threshold = input.float(0.15, "EMA 8 Slope Schwelle in ATR-Anteilen", step=0.05, group=grp_dash)grp_style = "Stil"zone_transp = input.int(88, "Transparenz Grauzone", minval=70, maxval=95, group=grp_style)inner_line_transp = input.int(80, "Transparenz innere Grenze", minval=50, maxval=95, group=grp_style)outer_line_transp = input.int(60, "Transparenz äußere Grenze", minval=30, maxval=95, group=grp_style)// Sicherheit: äußere Grenze darf nicht kleiner als innere seininner_band_mult = inner_band_mult_inouter_band_mult = math.max(outer_band_mult_in, inner_band_mult_in)// ==========================================// 2. SESSION// ==========================================is_xetra_session = not na(time(timeframe.period, trading_session + ":1234567", "Europe/Berlin"))is_xetra_start   = is_xetra_session and not is_xetra_session[1]// ==========================================// 3. AVWAP + STANDARDABWEICHUNGS-ZONEN// ==========================================var float s_pv  = 0.0var float s_v   = 0.0var float s_pv2 = 0.0if is_xetra_start    s_pv  := close * nz(volume, 1)    s_v   := nz(volume, 1)    s_pv2 := close * close * nz(volume, 1)else if is_xetra_session    s_pv  += close * nz(volume, 1)    s_v   += nz(volume, 1)    s_pv2 += close * close * nz(volume, 1)else    s_pv  := 0.0    s_v   := 0.0    s_pv2 := 0.0avwap = is_xetra_session and s_v > 0 ? s_pv / s_v : navariance = is_xetra_session and s_v > 0 ? math.max(0.0, (s_pv2 / s_v) - (avwap * avwap)) : nastdev    = math.sqrt(variance)// Innere Zone (z. B. 1.0)upper_inner = avwap + stdev * inner_band_multlower_inner = avwap - stdev * inner_band_mult// Äußere Zone (z. B. 1.5)upper_outer = avwap + stdev * outer_band_multlower_outer = avwap - stdev * outer_band_mult// ==========================================// 4. EMA 8// ==========================================ema8 = ta.ema(close, 8)// ==========================================// 5. DASHBOARD-WERTE// ==========================================// --- RVOL ---vol_sma20 = ta.sma(volume, 20)rvol = vol_sma20 > 0 ? volume / vol_sma20 : 0.0rvol_state =     rvol >= 1.2 ? "AKTIV" :     rvol < 0.8 ? "TOTE ZONE" :     "NORMAL"rvol_col =     rvol >= 1.2 ? C_BLUE :     rvol < 0.8 ? color.rgb(60, 60, 60) :     C_GRAY// --- Elder Impuls über MACD-Histogramm ---[macdLine, signalLine, _] = ta.macd(close, 12, 26, 9)hist = macdLine - signalLineelder_state =     hist > hist[1] and hist > 0 ? "STARK +" :     hist < hist[1] and hist < 0 ? "STARK -" :     "NEUTRAL"elder_col =     elder_state == "STARK +" ? C_BLUE :     elder_state == "STARK -" ? C_D_RED :     C_GRAY// --- Force Index ---fi_raw = volume * (close - close[1])fi2  = ta.ema(fi_raw, 2)fi13 = ta.ema(fi_raw, 13)fi_state =     fi13 > 0 and fi2 > 0 ? "FLOW +" :     fi13 < 0 and fi2 < 0 ? "FLOW -" :     fi13 > 0 and fi2 < 0 ? "RESET L" :     fi13 < 0 and fi2 > 0 ? "RESET S" :     "NEUTRAL"fi_col =     fi_state == "FLOW +" ? C_D_GREEN :     fi_state == "FLOW -" ? C_D_RED :     fi_state == "RESET L" ? C_TEAL :     fi_state == "RESET S" ? C_ORANGE :     C_GRAY// --- EMA 8 Slope ---atr_val = ta.atr(14)ema8_slope = atr_val > 0 ? (ema8 - ema8[1]) / atr_val : 0.0slope_state =     ema8_slope > slope_threshold ? "AUFWÄRTS" :     ema8_slope < -slope_threshold ? "ABWÄRTS" :     "FLACH"slope_col =     ema8_slope > slope_threshold ? C_D_GREEN :     ema8_slope < -slope_threshold ? C_D_RED :     C_GRAY// ==========================================// 6. AVWAP STATUS / MEAN-REVERSION-KONTEXT// ==========================================zone_label = str.tostring(inner_band_mult, "#.##") + " - " + str.tostring(outer_band_mult, "#.##") + " SD"extension_state =     close > upper_outer ? "OBERHALB +" + str.tostring(outer_band_mult, "#.##") :     close < lower_outer ? "UNTERHALB -" + str.tostring(outer_band_mult, "#.##") :     close > upper_inner ? "ZONE +" + str.tostring(inner_band_mult, "#.##") + " bis +" + str.tostring(outer_band_mult, "#.##") :     close < lower_inner ? "ZONE -" + str.tostring(inner_band_mult, "#.##") + " bis -" + str.tostring(outer_band_mult, "#.##") :     "VALUE"extension_col =     close > upper_outer ? C_ORANGE :     close < lower_outer ? C_ORANGE :     close > upper_inner ? C_GRAY :     close < lower_inner ? C_GRAY :     C_D_GREENextension_detail =     close > upper_outer ? "echte Überdehnung / Mean-Risk" :     close < lower_outer ? "echte Überdehnung / Mean-Risk" :     close > upper_inner ? "Beobachtungszone oberhalb" :     close < lower_inner ? "Beobachtungszone unterhalb" :     "im Normalbereich"// ==========================================// 6B. MEAN-REVERSION TRIGGER-LOGIK// ==========================================// Beobachtungszonenupper_watch = close > upper_innerlower_watch = close < lower_innerupper_extreme = close > upper_outerlower_extreme = close < lower_outer// Merker: Der Markt war in einer relevanten Überdehnungszonevar bool short_armed = falsevar bool long_armed  = false// Obere Überdehnung aktiviert Short-Beobachtungif upper_watch    short_armed := true// Untere Überdehnung aktiviert Long-Beobachtungif lower_watch    long_armed := true// Nach Rückkehr zum AVWAP wird die jeweilige Idee zurückgesetztif short_armed and close <= avwap    short_armed := falseif long_armed and close >= avwap    long_armed := false// Kerntrigger:// Short: EMA 8 fällt nach oberer Überdehnung zurück unter das obere 1.0-Band// Long: EMA 8 steigt nach unterer Überdehnung zurück über das untere 1.0-Bandready_short = short_armed and ta.crossunder(ema8, upper_inner)ready_long  = long_armed and ta.crossover(ema8, lower_inner)// Dashboard-Statustrigger_state =     ready_short ? "READY S" :     ready_long  ? "READY L" :     short_armed and upper_extreme ? "EXTREME S" :     long_armed and lower_extreme  ? "EXTREME L" :     short_armed ? "PREPARE S" :     long_armed  ? "PREPARE L" :     "WAIT"trigger_col =     ready_short ? C_D_RED :     ready_long  ? C_D_GREEN :     trigger_state == "EXTREME S" ? C_ORANGE :     trigger_state == "EXTREME L" ? C_ORANGE :     trigger_state == "PREPARE S" ? C_GRAY :     trigger_state == "PREPARE L" ? C_GRAY :     C_GRAYtrigger_detail =     ready_short ? "EMA8 zurück unter +1.0" :     ready_long  ? "EMA8 zurück über -1.0" :     trigger_state == "EXTREME S" ? "oberhalb äußerer Zone" :     trigger_state == "EXTREME L" ? "unterhalb äußerer Zone" :     trigger_state == "PREPARE S" ? "obere Beobachtungszone" :     trigger_state == "PREPARE L" ? "untere Beobachtungszone" :     "kein Reversal-Setup"// ==========================================// 7. PLOTS// ==========================================// AVWAPplot_avwap = plot(show_avwap and not na(avwap) ? avwap : na,     "AVWAP",     color=C_WHITE,     linewidth=2,     style=plot.style_linebr)// Innere Grenzeplot_upper_inner = plot(show_bands and not na(upper_inner) ? upper_inner : na,     "Obere innere Grenze",     color=color.new(C_GRAY, inner_line_transp),     linewidth=1,     style=plot.style_linebr)plot_lower_inner = plot(show_bands and not na(lower_inner) ? lower_inner : na,     "Untere innere Grenze",     color=color.new(C_GRAY, inner_line_transp),     linewidth=1,     style=plot.style_linebr)// Äußere Grenzeplot_upper_outer = plot(show_bands and not na(upper_outer) ? upper_outer : na,     "Obere äußere Grenze",     color=color.new(C_WHITE, outer_line_transp),     linewidth=1,     style=plot.style_linebr)plot_lower_outer = plot(show_bands and not na(lower_outer) ? lower_outer : na,     "Untere äußere Grenze",     color=color.new(C_WHITE, outer_line_transp),     linewidth=1,     style=plot.style_linebr)// Graue Zonen zwischen 1.0 und 1.5fill(plot_upper_inner, plot_upper_outer, color=color.new(C_GRAY, zone_transp), title="Obere Beobachtungszone")fill(plot_lower_inner, plot_lower_outer, color=color.new(C_GRAY, zone_transp), title="Untere Beobachtungszone")// EMA 8plot(show_ema8 ? ema8 : na,     "EMA 8",     color=C_CYAN,     linewidth=2)// leichte Hintergrundmarkierung außerhalb Sessionbgcolor(not is_xetra_session ? color.new(C_D_RED, 95) : na)// ==========================================// 8. DASHBOARD// ==========================================var table dash = table.new(     position.top_right,     3,     8,     bgcolor=color.rgb(15, 25, 50, 90),     border_width=1,     border_color=color.rgb(40, 60, 100))if barstate.islast and show_dashboard    table.cell(dash, 0, 0, "MEAN MAP", text_color=C_WHITE, bgcolor=C_D_BLUE)    table.cell(dash, 1, 0, "STATUS", text_color=C_WHITE, bgcolor=C_D_BLUE)    table.cell(dash, 2, 0, "DETAIL", text_color=C_WHITE, bgcolor=C_D_BLUE)    table.cell(dash, 0, 1, "POSITION", text_color=C_WHITE)    table.cell(dash, 1, 1, extension_state, bgcolor=extension_col, text_color=C_WHITE)    table.cell(dash, 2, 1, extension_detail, text_color=C_WHITE)    table.cell(dash, 0, 2, "ZONE", text_color=C_WHITE)    table.cell(dash, 1, 2, zone_label, bgcolor=C_GRAY, text_color=C_WHITE)    table.cell(dash, 2, 2, "Beobachtung/Aktion", text_color=C_WHITE)    table.cell(dash, 0, 3, "TRIGGER", text_color=C_WHITE)    table.cell(dash, 1, 3, trigger_state, bgcolor=trigger_col, text_color=C_WHITE)    table.cell(dash, 2, 3, trigger_detail, text_color=C_WHITE)    table.cell(dash, 0, 4, "RVOL", text_color=C_WHITE)    table.cell(dash, 1, 4, str.tostring(rvol, "#.##"), bgcolor=rvol_col, text_color=C_WHITE)    table.cell(dash, 2, 4, rvol_state, text_color=C_WHITE)    table.cell(dash, 0, 5, "ELDER", text_color=C_WHITE)    table.cell(dash, 1, 5, elder_state, bgcolor=elder_col, text_color=C_WHITE)    table.cell(dash, 2, 5, "MACD Impuls", text_color=C_WHITE)    table.cell(dash, 0, 6, "FI", text_color=C_WHITE)    table.cell(dash, 1, 6, fi_state, bgcolor=fi_col, text_color=C_WHITE)    table.cell(dash, 2, 6, "FI2/FI13", text_color=C_WHITE)    table.cell(dash, 0, 7, "EMA8 SLOPE", text_color=C_WHITE)    table.cell(dash, 1, 7, str.tostring(ema8_slope, "#.##"), bgcolor=slope_col, text_color=C_WHITE)    table.cell(dash, 2, 7, slope_state, text_color=C_WHITE)